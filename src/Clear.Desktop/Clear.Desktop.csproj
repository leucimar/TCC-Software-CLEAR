<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Clear.Application\Clear.Application.csproj" />
    <ProjectReference Include="..\Clear.Infrastructure\Clear.Infrastructure.csproj" />
    <ProjectReference Include="..\Clear.Domain\Clear.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(ClearLayout)' == 'Lateral'">
    <RuntimeHostConfigurationOption Include="Clear.LayoutSuperior" Value="false" />
  </ItemGroup>

</Project>
